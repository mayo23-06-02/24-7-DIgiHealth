# --- Supabase (one project per environment: dev and production) ---
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only, bypasses RLS
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
MEDIA_BUCKET=media

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com

# --- Sessions ---
JWT_SECRET=                                    # required; 32+ random chars. Unset = every request is signed out
AUTH_SECRET=                                   # NextAuth (Google/Facebook sign-in)
DISABLE_AUTH_RATE_LIMIT=false

# --- Seeding (dev databases ONLY) ---
# ALLOW_SEED=true
# PROTECTED_SUPABASE_REFS=<comma-separated project refs the seed must never touch>

# --- Realtime / calls ---
ABLY_API_KEY=
ABLY_CHANNEL_PREFIX=
NEXT_PUBLIC_ABLY_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email ---
RESEND_API_KEY=
MAILJET_FROM_EMAIL=
CLINICAL_TEAM_EMAIL=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# --- Cron ---
CRON_SECRET=
